{
  "manifest_version": 3,
  "name": "Village React Extension",
  "version": "1.0.0",
  "description": "Village browser extension built with React",
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "Village React Extension"
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}