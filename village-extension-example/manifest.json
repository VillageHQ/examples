{
  "manifest_version": 3,
  "name": "Village Network Extension",
  "version": "1.0.0",
  "description": "Find introductions and network paths using Village SDK",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://api.village.do/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*", "http://localhost:*/*", "https://*/*"],
      "js": ["src/simple-content.js"],
      "css": ["src/content.css"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Village Network"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["public/village-sdk.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
